root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
ktlint_code_style = android_studio
# Las funciones @Composable empiezan con mayúscula por convención de Compose.
ktlint_function_naming_ignore_when_annotated_with = Composable
ktlint_standard_function-naming = enabled

[*.{xml,toml,md}]
indent_size = 4
