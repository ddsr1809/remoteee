<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+. Los secretos cifrados y el keyset de Tink no se copian: la clave maestra
    vive en el Keystore de ESTE teléfono y en otro dispositivo serían ilegibles.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="remoto_tink_keyset.xml" />
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="remoto_tink_keyset.xml" />
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
