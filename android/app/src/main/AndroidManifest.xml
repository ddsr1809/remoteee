<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Hito 1: el modo demostración no usa la red, así que no se declara ningún permiso.
        Los de la sección 7.4 (INTERNET, ACCESS_NETWORK_STATE, ACCESS_WIFI_STATE,
        CHANGE_WIFI_MULTICAST_STATE, TRANSMIT_IR) se añaden en el hito que los necesita.
        Con targetSdk 36 NO se declara ACCESS_LOCAL_NETWORK.
    -->

    <application
        android:name=".RemotoApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Remoto"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Remoto">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
